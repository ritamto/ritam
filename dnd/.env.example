# Server-only. NEVER prefix with VITE_ (that would ship it to the browser).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_BASE_URL=https://ai.hackclub.com/proxy/v1
# Neon connection string. Leave empty to use in-memory rooms (dev only).
DND_DATABASE_URL=
# AI cost guardrails (estimated tokens). 0 disables AI -> templated narration.
AI_BUDGET_TOKENS_GLOBAL=200000
AI_BUDGET_TOKENS_PER_ROOM=20000
PORT=8787
